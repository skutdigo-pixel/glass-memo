# Google OAuth (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, Web application)
# Authorized redirect URI: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BASE_URL=https://your-app.fly.dev

# Cloudflare Workers AI (API token with "Workers AI" permission)
CF_ACCOUNT_ID=
CF_API_TOKEN=
# CF_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Local development only (ignored when NODE_ENV=production)
# DEV_AUTH=1   # enables /auth/dev, a stand-in for Google login
# AI_MOCK=1    # offline stand-in for Workers AI
